#!/usr/bin/env bash
#
# Wrapper around the QuantConnect LEAN CLI that keeps the CLI's temporary files
# inside a directory Docker can actually bind-mount.
#
# Why this exists
# ---------------
# The Python LEAN CLI (pip package `lean`) writes every file it bind-mounts into
# its containers (`Directory.Build.props`, `copy_csharp_dependencies.py`,
# `lean-cli-start.sh`, ...) into a `lean-cli-*` directory under `$TMPDIR`, which
# defaults to `/tmp`. Docker Desktop only shares paths below `$HOME` with its VM,
# so container creation is rejected with an error like:
#
#   Error: 400 Client Error for http+docker://localhost/v1.56/containers/create
#   ... Bad Request ("invalid mount config for type "bind": bind source path
#   does not exist: /tmp/lean-cli-XXXX/Directory.Build.props")
#
# Exporting a `$TMPDIR` below `$HOME` fixes this for every lean command
# (`backtest`, `live`, `optimize`, `research`, `report`, ...). Nothing else about
# the CLI changes.
#
# Usage (identical to the real CLI, e.g.):
#   scripts/lean backtest Strategies/NVDACoxxStrat/
#   scripts/lean report
#
# The same `$TMPDIR` can be exported shell-wide by running
# `scripts/install_lean_tmpdir_hook.sh` once per conda environment.
#
# Override the temp directory with LEAN_CLI_TMPDIR (it must stay below $HOME when
# Docker Desktop is the daemon).

set -euo pipefail

# Resolve symlinks so a wrapper copied/symlinked into PATH is still recognised.
resolve_self() {
  local path="$1" target
  while [ -L "$path" ]; do
    target="$(readlink "$path")"
    case "$target" in
      /*) path="$target" ;;
      *) path="$(dirname "$path")/${target}" ;;
    esac
  done
  printf '%s/%s\n' "$(cd -- "$(dirname "$path")" && pwd -P)" "$(basename "$path")"
}

wrapper_path="$(resolve_self "${BASH_SOURCE[0]}")"

# Defensive guard: two copies of this wrapper on PATH would otherwise ping-pong.
wrapper_depth="${LEAN_CLI_WRAPPER_DEPTH:-0}"
if [ "$wrapper_depth" -ge 3 ] 2>/dev/null; then
  echo "error: the lean wrapper re-executed itself 3 times; check PATH for duplicate copies." >&2
  exit 127
fi
export LEAN_CLI_WRAPPER_DEPTH=$((wrapper_depth + 1))

# Docker Desktop shares $HOME (and a few system paths) with its VM, but not /tmp.
lean_tmpdir="${LEAN_CLI_TMPDIR:-${XDG_CACHE_HOME:-${HOME}/.cache}/lean-cli/tmp}"
if ! mkdir -p -- "$lean_tmpdir" 2>/dev/null; then
  echo "error: could not create the lean CLI temp directory: ${lean_tmpdir}" >&2
  echo "       set LEAN_CLI_TMPDIR to a writable directory below \$HOME." >&2
  exit 1
fi

# Locate the real lean executable, skipping this wrapper so we never recurse.
resolve_lean() {
  local remainder="${PATH}:" entry candidate
  while [ -n "${remainder}" ]; do
    entry="${remainder%%:*}"
    remainder="${remainder#*:}"
    [ -n "${entry}" ] || continue
    candidate="${entry}/lean"
    { [ -f "$candidate" ] && [ -x "$candidate" ]; } || continue
    if [ "$(resolve_self "$candidate")" != "$wrapper_path" ]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

if ! real_lean="$(resolve_lean)"; then
  echo "error: could not find the 'lean' executable in PATH." >&2
  echo "       this wrapper does not replace the LEAN CLI; install it with 'pip install lean'." >&2
  exit 127
fi

export TMPDIR="$lean_tmpdir"
export TEMP="$lean_tmpdir"
export TMP="$lean_tmpdir"

# Cheap preflight: fail with an actionable message instead of a raw Docker 400.
# Only runs when the engine image is already present, so it stays fast and never
# triggers a pull. It probes a *file* with `--mount`, which is how the LEAN CLI
# talks to the Docker API, and is exactly what breaks when $TMPDIR is not shared.
warn_if_docker_cannot_mount() {
  command -v docker >/dev/null 2>&1 || return 0
  local image="quantconnect/lean:latest"
  docker image inspect "$image" >/dev/null 2>&1 || return 0

  local probe="${TMPDIR}/.lean-cli-mount-probe" name="lean-cli-mount-check-$$" output
  : > "$probe" 2>/dev/null || return 0

  if output="$(docker create --name "$name" \
      --mount "type=bind,source=${probe},target=/lean-cli-mount-probe" \
      --entrypoint /bin/true "$image" 2>&1 1>/dev/null)"; then
    docker rm -f "$name" >/dev/null 2>&1 || true
    rm -f "$probe" 2>/dev/null || true
    return 0
  fi

  docker rm -f "$name" >/dev/null 2>&1 || true
  rm -f "$probe" 2>/dev/null || true
  {
    printf 'warning: docker cannot bind-mount %s from the host:\n' "$TMPDIR"
    printf '%s\n' "$output" | sed 's/^/  /'
    printf '         point LEAN_CLI_TMPDIR at a directory Docker Desktop shares, or add\n'
    printf '         /tmp to Docker Desktop > Settings > Resources > File sharing.\n'
    printf '         the same rule applies to paths you pass to lean (e.g.\n'
    printf '         --report-destination): keep them below $HOME, not in /tmp.\n'
  } >&2
}

warn_if_docker_cannot_mount

exec "$real_lean" "$@"
